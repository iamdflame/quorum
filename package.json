{
  "name": "shoal",
  "private": true,
  "version": "0.1.0",
  "description": "Anonymity aggregation. You do not pick a pool \u2014 you pick to be indistinguishable.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b packages/oracle packages/router packages/chain",
    "test": "node --test --experimental-strip-types packages/oracle/test/*.test.ts packages/router/test/*.test.ts",
    "typecheck": "tsc -b packages/oracle packages/router packages/chain",
    "demo": "npm run build && node examples/the-crowd-you-are-in.mjs",
    "live": "npm run build && node examples/live-mainnet.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "starknet": "^10.7.1"
  }
}