{
  "name": "quorum",
  "private": true,
  "version": "0.1.0",
  "description": "Threshold coordination on Starknet. Nobody is exposed until enough people commit.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "archive/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b packages/protocol packages/chain packages/linkage",
    "test": "node --test --experimental-strip-types packages/protocol/test/*.test.ts packages/linkage/test/*.test.ts",
    "typecheck": "tsc -b packages/protocol packages/chain packages/linkage",
    "demo": "npm run build && node examples/the-crowd-you-are-in.mjs",
    "live": "npm run build && node examples/live-mainnet.mjs",
    "pipeline": "npm run build && node examples/pipeline.mjs",
    "linkage": "npm run build && node examples/linkage.mjs",
    "entities": "npm run build && node examples/entities.mjs",
    "test:bridge": "node --test --experimental-strip-types packages/sdk-bridge/test/*.test.ts",
    "test:contracts": "cd contracts && snforge test",
    "build:archive": "tsc -b archive/oracle archive/router archive/execute archive/sdk-bridge",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "starknet": "^10.7.1"
  }
}